# --- AI (optional: without a key the app runs on the rules engine only) ---
# Free key: https://aistudio.google.com/apikey   Put it here, never in code or chat. .env is git-ignored.
GEMINI_API_KEY=AIzaSyCHfmVDiwvXe7i0fe6uNPyPrsGK5a9yTao
GEMINI_MODEL=gemini-2.5-flash
# Used automatically if the main model is unavailable or its quota is exhausted (comma separated)
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# Minimum gap between Gemini calls in ms (protects free-tier rate limits). Lower it on a paid plan.
GEMINI_MIN_INTERVAL_MS=3000

# --- Location hazard lookup (FEMA flood data + US Census geocoder). Set to off to disable. ---
HAZARD_LOOKUP=on

# --- Work queue ---
SLA_HOURS=4
MANUAL_MINUTES=45
PORT=3000
